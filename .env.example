# Copy to .env.local and fill in. Never commit real values (11-guvenlik §10).
# Every variable is validated at start-up by src/lib/env.ts and src/lib/public-env.ts.

# ── Database ─────────────────────────────────────────────────────────
# Local: docker compose up -d. Neon: pooled URL here, direct URL below.
DATABASE_URL=postgres://app:app@localhost:5434/app
# Direct (unpooled) connection, used by migrations. Optional locally.
DATABASE_URL_UNPOOLED=

# ── Site ─────────────────────────────────────────────────────────────
# Canonical public address, no trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# true: noindex, demo banner, messages go to the demo outbox, db:reset allowed.
# false (live): RESEND_API_KEY and EMAIL_FROM become mandatory; DEMO_ADMIN_* must be empty.
DEMO_MODE=true

# ── Auth (Better Auth) ───────────────────────────────────────────────
# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Seeded demo admin (demo environments only). Password: at least 15 characters.
DEMO_ADMIN_EMAIL=yonetici@demo.example.com
DEMO_ADMIN_PASSWORD=

# ── Security ─────────────────────────────────────────────────────────
# Salt for hashing IPs in consent and audit records. openssl rand -hex 16
IP_HASH_SALT=
# Bearer token Vercel Cron sends to /api/cron/*. openssl rand -hex 24
CRON_SECRET=
# Optional bot protection (E-20)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Channels ─────────────────────────────────────────────────────────
# E-mail (Resend). Leave empty in demo: messages are written to the demo outbox.
RESEND_API_KEY=
# "Firma Adı <bildirim@alanadi.com.tr>" — domain verified with SPF, DKIM, DMARC
EMAIL_FROM=

# ── Storage and monitoring ───────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=
SENTRY_DSN=
