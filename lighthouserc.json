{
  "ci": {
    "collect": {
      "startServerCommand": "node node_modules/next/dist/bin/next start -p 3200",
      "startServerReadyPattern": "Ready",
      "url": [
        "http://localhost:3200/",
        "http://localhost:3200/galeri",
        "http://localhost:3200/galeri/renkli-puantiye",
        "http://localhost:3200/hizmetler/kalici-oje",
        "http://localhost:3200/iletisim"
      ],
      "numberOfRuns": 1,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new",
        "onlyCategories": ["performance", "accessibility", "best-practices", "seo"]
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "assertions": {
            "categories:performance": ["warn", { "minScore": 0.9 }],
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:best-practices": ["error", { "minScore": 0.95 }],
            "document-title": "error",
            "meta-description": "error",
            "http-status-code": "error",
            "link-text": "error",
            "crawlable-anchors": "error",
            "image-alt": "error",
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
            "resource-summary:font:size": ["error", { "maxNumericValue": 175000 }],
            "resource-summary:image:size": ["error", { "maxNumericValue": 307200 }],
            "resource-summary:third-party:count": ["error", { "maxNumericValue": 0 }]
          }
        },
        {
          "matchingUrlPattern": "^((?!/iletisim).)*$",
          "assertions": {
            "resource-summary:script:size": ["error", { "maxNumericValue": 215000 }]
          }
        },
        {
          "matchingUrlPattern": "/iletisim$",
          "assertions": {
            "resource-summary:script:size": ["error", { "maxNumericValue": 250000 }]
          }
        }
      ]
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}
