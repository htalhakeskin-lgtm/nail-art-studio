# Vitest environment (NODE_ENV=test loads this file, never .env.local). No real secrets here;
# CI sets the same variables in the workflow and they take precedence.
DATABASE_URL=postgres://app:app@localhost:5434/app_test
NEXT_PUBLIC_SITE_URL=http://localhost:3000
DEMO_MODE=true
BETTER_AUTH_SECRET=test-only-value-not-a-secret-0123456789
BETTER_AUTH_URL=http://localhost:3000
IP_HASH_SALT=test-only-salt-0123456789
CRON_SECRET=test-only-cron-value-0123
